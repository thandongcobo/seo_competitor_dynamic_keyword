DATAFORSEO_LOGIN=ngcobot@hollywoodbets.net
DATAFORSEO_PASSWORD=e512202adfbb7a2f

KEYWORD=aviator
LANGUAGE_CODE=en

# Playwright browser geolocation target used for local SERP collection. The radius is retained as project metadata.
LOCATION_COORDINATE=-29.7359502,31.0699179,200

# Labs uses its own supported location context. Keep this separate from SERP.
LABS_LOCATION_NAME=South Africa

OUR_DOMAIN=hollywoodbets.net
BENCHMARK_COMPETITOR_DOMAIN=betway.co.za

# Optional. Leave blank; ranking URLs will be discovered from the SERP response.
OUR_PAGE_URL=
COMPETITOR_PAGE_URL=

SERP_DEPTH=50
COMPETITOR_WINDOW=5
CANDIDATE_CRAWL_LIMIT=12

# Optional. Leave blank to auto-detect installed Chrome/Edge.
PLAYWRIGHT_BROWSER_PATH=

# Public page captures wait up to this long for meaningful rendered content.
# The scraper can finish sooner once content remains stable for the stability window.
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=60000
PLAYWRIGHT_RENDER_TIMEOUT_SECONDS=45
PLAYWRIGHT_RENDER_MINIMUM_SECONDS=4
PLAYWRIGHT_RENDER_STABILITY_SECONDS=2
