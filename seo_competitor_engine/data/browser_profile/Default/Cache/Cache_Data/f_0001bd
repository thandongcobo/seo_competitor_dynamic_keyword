                click2connectFrame.contentWindow.postMessage(JSON.stringify(click2ConnectStartData), 'https://' + click2connect.params.click2connect_server);
            }
        }
    }

    // Legacy redirect support: broadcast alotech_initialize to customer site when click2connect_initialized
    if (data.type === "chat" && data.action === "click2connect_initialized") {
        if (click2connect.is_legacy_redirect) {
            window.postMessage(JSON.stringify({type: "chat", action: "alotech_initialize"}), '*');
        }
        
        if (click2connect.scheduled_auto_start) {
            setTimeout(function(){
                if (click2connectFrame) {
                    click2connectFrame.contentWindow.postMessage(JSON.stringify({
                            action: 'click2connect_external_chat_start',
                            formdata: {
                                phone_number: click2connect.scheduled_auto_start_phone_number,
                                name: click2connect.scheduled_auto_start_name,
                                email: click2connect.scheduled_auto_start_email
                            },
                        }),
                    'https://' + click2connect.params.click2connect_server);
                }
            }, parseInt(click2connect.scheduled_auto_start_time) * 1000);
        }
    }

    if (data.type === "alotech_chat" && data.alotech_data) {
        var alotechLocHref = "";
        for(var key in data.alotech_data){
            if (key === "client_name" || key === "client_email" || key === "phone_number") {
                Click2ConnectSetCookie(key, data.alotech_data[key], 730, data.alotech_data.hostname);
            } else {
                Click2ConnectSetCookie(key, data.alotech_data[key], 1, data.alotech_data.hostname);
            }
        }
        if (data.action === "chatLogout") {
            if (Click2ConnectGetCookie("chat_evaluation", data.alotech_data.hostname) != "true") {
                Click2ConnectSetCookie("active_chat_key", "", 1, data.alotech_data.hostname);
            }
        } else if (data.action === "NewAloChat") {
            var alotechLegalHref = false;
            if(Click2ConnectGetCookie('chat_evaluation', data.alotech_data.hostname) !== "true"){
                Click2ConnectSetCookie("active_chat_key", "", 1, data.alotech_data.hostname);
                if (Click2ConnectGetCookie("legal_requirements", data.alotech_data.hostname) === 'true'){
                    alotechLocHref = Click2ConnectGetCookie("legal_href", data.alotech_data.hostname);
                    alotechLegalHref = true;
                }
            }

                try {
                    if (!alotechLegalHref) {
                        alotechLocHref = '//' + Click2ConnectGetCookie('ws_server', data.alotech_data.hostname)
                        alotechLocHref += '?hostname=' + Click2ConnectGetCookie('hostname', data.alotech_data.hostname);
                        alotechLocHref += '&lang=' + Click2ConnectGetCookie('lang', data.alotech_data.hostname);
                        alotechLocHref += '&queue=' + Click2ConnectGetCookie('chat_queue', data.alotech_data.hostname);
                        alotechLocHref += '&cwid=' + Click2ConnectGetCookie('cwid', data.alotech_data.hostname);

                        if (Click2ConnectGetCookie('optional_email', data.alotech_data.hostname)) {
                            alotechLocHref += '&optional_email=' + Click2ConnectGetCookie('optional_email', data.alotech_data.hostname);
                        } else {
                            if (Click2ConnectGetCookie('optional_email', data.alotech_data.hostname) === 'required'){
                                alotechLocHref += '&optional_email=required';
                            }
                            else {
                                alotechLocHref += '&optional_email=';
                            }
                        }
                        if(Click2ConnectGetCookie('chat_evaluation', data.alotech_data.hostname) === "true"){
                            alotechLocHref += '&chat_evaluation=' + Click2ConnectGetCookie('chat_evaluation', data.alotech_data.hostname);
                        }

                        if (Click2ConnectGetCookie('optional_phone', data.alotech_data.hostname)) {
                            alotechLocHref += '&optional_phone=' + Click2ConnectGetCookie('optional_phone', data.alotech_data.hostname);
                        } else {
                            if (Click2ConnectGetCookie('optional_phone', data.alotech_data.hostname) === 'required'){
                                alotechLocHref += '&optional_phone=required';
                            }
                            else {
                                alotechLocHref += '&optional_phone=';
                            }
                        }
                        if (Click2ConnectGetCookie('tags', data.alotech_data.hostname)) {
                            alotechLocHref += '&tags=' + Click2ConnectGetCookie('tags', data.alotech_data.hostname);
                        } else {
                            alotechLocHref += '&tags=';
                        }
                        if (Click2ConnectGetCookie('customer_history', data.alotech_data.hostname)) {
                            alotechLocHref += '&customer_history=' + Click2ConnectGetCookie('customer_history', data.alotech_data.hostname);
                        }
                        alotechLocHref += '&repeat_chat=true';
                        Click2ConnectSetCookie('reconnect', '', 1, data.alotech_data.hostname);
                    }
                } catch (e) {
                    console.log(e);
                }

        } else if (data.action === "chatEvaluationOnload") {
            Click2ConnectSetCookie("chat_evaluation", "", 1, data.alotech_data.hostname);
        }

        if (data.returnNow === true) {
            var click2ConnectData = {
                active_chat_key: Click2ConnectGetCookie('active_chat_key', data.alotech_data.hostname),
                active_chat_room: Click2ConnectGetCookie('active_chat_room', data.alotech_data.hostname),
                //customer_path: Click2ConnectGetCookie('customer_path', data.alotech_data.hostname),
                pToken: Click2ConnectGetCookie('pToken', data.alotech_data.hostname),
                reconnect: Click2ConnectGetCookie('reconnect', data.alotech_data.hostname),
                chat_evaluation: Click2ConnectGetCookie('chat_evaluation', data.alotech_data.hostname),
                chat_evaluation_message: Click2ConnectGetCookie('chat_evaluation_message', data.alotech_data.hostname),
                customer_history_id: Click2ConnectGetCookie('customer_history_id', data.alotech_data.hostname),
                send_chat_history_to_customer: Click2ConnectGetCookie('send_chat_history_to_customer', data.alotech_data.hostname),
                ws_server: Click2ConnectGetCookie('ws_server', data.alotech_data.hostname)
            };
            if (data.action === "roomOnload") {
                click2ConnectData.first_welcoming_message = Click2ConnectGetCookie('first_welcoming_message', data.alotech_data.hostname);
                click2ConnectData.queue_message =  Click2ConnectGetCookie('queue_message', data.alotech_data.hostname);
            }
            if(click2connectFrame){
                click2connectFrame.contentWindow.postMessage(JSON.stringify({
                    action: 'aloTechCrossDomainMessage',
                    cData: click2ConnectData,
                    message: data.action,
                    messageData: {
                        locHref: data.action === "NewAloChat" ? alotechLocHref : ""
                    }
                }), 'https://' + click2connect.params.click2connect_server);
            }
        }
    }
    if(data.action === "send_message" && data.type === "chatting"){
        if(data.focus){
            clearInterval(focus_interval);
            focus_interval = 0;
            //document.title = click2connect.alochat_page_title;
        }
        if(!data.focus && !document.hasFocus() && data.show_title_notification){
            if(document.title == click2connect.alochat_page_title && !focus_interval){
                focus_interval = setInterval(function(){
                    //document.title = document.title == click2connect.alochat_page_title ? data.name + " send you a message" : click2connect.alochat_page_title;
                }, 3000);
            }
        }
        if(data.play_message_sounds && !data.muteChat){
            try {
                var chat_message_sound = "https://" + data.ns + "/static/js/webrtc/sound/message_sound.mp3";
                sound = new Audio(chat_message_sound);
                sound.volume = 0.7;
                sound.play();
            }
            catch(err) {
                console.log(err.message);
            }
        }
        window.addEventListener("focus", function(){
            clearInterval(focus_interval);
            focus_interval = 0;
            //document.title = click2connect.alochat_page_title;
        });
    }
    });
}

