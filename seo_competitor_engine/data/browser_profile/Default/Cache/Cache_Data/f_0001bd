function Click2ConnectSetCookie(cname, cvalue, exdays, hostname) {
    try {
        var d = new Date();
        d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
        var expires = "expires=" + d.toUTCString();
        document.cookie = hostname + "_" + cname + "=" + cvalue + ";" + expires + ";path=/;SameSite=None;" + "Secure";
    } catch (e) {
        console.log("Click2Connect: Cookie set failed - ", e.message);
    }
}

function Click2ConnectGetCookie(cname, hostname, source) {
    try {
        if (source === "masterPage") {
            var name = cname + "=";
        } else {
            var name = hostname + "_" + cname + "=";
        }
        var ca = document.cookie.split(';');
        for (var i = 0; i < ca.length; i++) {
            var c = ca[i];
            while (c.charAt(0) == ' ') {
                c = c.substring(1);
            }
            if (c.indexOf(name) == 0) {
                return c.substring(name.length, c.length);
            }
        }
    } catch (e) {
        console.log("Click2Connect: Cookie get failed - ", e.message);
    }
    return "";
}

function Click2ConnectDraw(customize) {
    var click2ConnectFrame = document.createElement("iframe");
    var fullscreen_without_launcher = customize.fullscreen_without_launcher;

    click2ConnectFrame.setAttribute('src', click2connect.iframe.src);
    click2ConnectFrame.setAttribute('frameborder', "0");
    click2ConnectFrame.setAttribute('allow', 'camera *;microphone *;geolocation *');
    click2ConnectFrame.setAttribute('id', 'Click2ConnectPackageFrame');
    click2ConnectFrame.setAttribute('title', click2connect.iframe_title);
    click2ConnectFrame.style.height = fullscreen_without_launcher ? '100%' : '86px';
    click2ConnectFrame.style.width = fullscreen_without_launcher ? '100%' : (customize.type === "icontext" ? '150px' : "55px");
    click2ConnectFrame.style.marginRight = fullscreen_without_launcher ? '0px' : '5px';
    click2ConnectFrame.style.marginLeft = fullscreen_without_launcher ? '0px' : '5px';
    click2ConnectFrame.style.position = 'fixed';
    click2ConnectFrame.style.zIndex = '999999';
    click2ConnectFrame.style.bottom = fullscreen_without_launcher ? '0px' : '8px';
    if(click2connect.widget_position == "lb"){
        click2ConnectFrame.style.left = '0px';
    }else{
        click2ConnectFrame.style.right = '0px';
    }
    click2connect.customize = JSON.stringify(customize);
    
    // Legacy redirect support - .alotech-chat-body wrapper for old chat widget code compatibility
    // display: contents makes wrapper invisible but still queryable in DOM
    if (click2connect.is_legacy_redirect) {
        var alotechChatBody = document.createElement("div");
        alotechChatBody.classList.add('alotech-chat-body');
        alotechChatBody.style.display = 'contents';
        alotechChatBody.appendChild(click2ConnectFrame);
        document.body.appendChild(alotechChatBody);
    } else {
        document.body.appendChild(click2ConnectFrame);
    }
}

function Click2ConnectAjax(option, extraParams) {
    if (typeof(option.url) == "undefined") {
        try {
            option.url = location.href;
        } catch(e) {
            var ajaxLocation;
            ajaxLocation = document.createElement("a");
            ajaxLocation.href = "";
            option.url = ajaxLocation.href;
        }
    }
    if (typeof(option.type) == "undefined") {
        option.type = "GET";
    }
    if (typeof(option.method) == "undefined") {
        option.method = "GET";
    }
    if (typeof(option.data) == "undefined") {
        option.data = null;
    } else if (typeof(option.data) !== "string"){
        var data = "";
        for (var x in option.data) {
            if (data != "") {
                data += "&";
            }
            data += encodeURIComponent(x)+"="+encodeURIComponent(option.data[x]);
        };
        option.data = data;
    }
    if (typeof(option.statusCode) == "undefined") {
        option.statusCode = {};
    }
    if (typeof(option.beforeSend) == "undefined") {
        option.beforeSend = function () {};
    }
    if (typeof(option.success) == "undefined") {
        option.success = function () {};
    }
    if (typeof(option.error) == "undefined") {
        option.error = function () {};
    }
    if (typeof(option.complete) == "undefined") {
        option.complete = function () {};
    }
    typeof(option.statusCode["404"]);

    var xhr = null;

    if (window.XMLHttpRequest || window.ActiveXObject) {
        if (window.ActiveXObject) { try { xhr = new ActiveXObject("Msxml2.XMLHTTP"); } catch(e) { xhr = new ActiveXObject("Microsoft.XMLHTTP"); } }
        else { xhr = new XMLHttpRequest(); }
    } else { console.log("Your browser does not support XMLHTTPRequest object."); return null; }

    xhr.onreadystatechange = function() {
        if (xhr.readyState == 1) {
            option.beforeSend();
        }
        if (xhr.readyState == 4) {
            if (xhr.status == 200 || xhr.status == 0) {
                option.success(JSON.parse(xhr.responseText));
            } else {
                option.error(xhr.status);
                if (typeof(option.statusCode[xhr.status]) != "undefined") {
                    option.statusCode[xhr.status]();
                }
            }
            option.complete(xhr, xhr.status);
        }
    };

    if (option.type == "POST") {
        xhr.open(option.type, option.url, true);
        xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");
        if (extraParams && extraParams.application_provider === "aws") {
            xhr.setRequestHeader("X-Namespace", extraParams.namespace);
        }
        xhr.send(option.data);
    } else {
        if (option.data){
            xhr.open(option.type, option.url+option.data, true);
            xhr.send(null);
        } else {
            xhr.open(option.type, option.url, true);
            xhr.send(null);
        }
    }
}

function getParameterByName(name) {
    name = name.replace(/[\[]/, "\\\[").replace(/[\]]/, "\\\]");
    var regexS = "[\\?&]" + name + "=([^&#]*)";
    var regex = new RegExp(regexS);
    var results = regex.exec(window.location.search);
    if(results == null)
        return "";
    else
        return decodeURIComponent(results[1].replace(/\+/g, " "));
}

